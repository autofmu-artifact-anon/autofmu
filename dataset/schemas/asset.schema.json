{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnifiedAsset",
  "type": "object",
  "required": [
    "schema",
    "asset_id",
    "source_type",
    "name",
    "fmu_relpath",
    "metadata_relpath",
    "ports"
  ],
  "properties": {
    "schema": {"type": "string"},
    "asset_id": {"type": "string"},
    "source_type": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "fmu_relpath": {"type": "string"},
    "metadata_relpath": {"type": "string"},
    "description_relpath": {"type": "string"},
    "fmi_version": {"type": "string"},
    "fmi_types": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "ports": {"type": "array", "items": {"type": "object"}},
    "capabilities": {"type": "object"},
    "default_experiment": {"type": "object"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "library_visible": {"type": "boolean"},
    "ground_truth_only": {"type": "boolean"},
    "case_origin": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"}
  }
}

