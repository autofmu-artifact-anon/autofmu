{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnifiedSolution",
  "type": "object",
  "definitions": {
    "solutionExtensions": {
      "type": "object",
      "properties": {
        "fault_injection": {"type": "object"},
        "model_swap": {"type": "object"},
        "runtime_io": {"type": "object"},
        "raw_config_relpaths": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "solutionStage": {
      "type": "object",
      "properties": {
        "stage_id": {"type": "string"},
        "selected_asset_ids": {"type": "array", "items": {"type": "string"}},
        "connections": {"type": "array", "items": {"type": "object"}},
        "external_inputs": {"type": "array", "items": {"type": "object"}},
        "monitored_outputs": {"type": "array", "items": {"type": "object"}},
