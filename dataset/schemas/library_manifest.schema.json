{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnifiedLibraryManifest",
  "type": "object",
  "required": ["schema", "asset_count", "assets"],
  "properties": {
    "schema": {"type": "string"},
    "version": {"type": "integer"},
    "asset_count": {"type": "integer"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "relative_dir", "fmu_file", "asset_file"],
        "properties": {
          "asset_id": {"type": "string"},
          "name": {"type": "string"},
          "relative_dir": {"type": "string"},
          "fmu_file": {"type": "string"},
          "asset_file": {"type": "string"},
          "metadata_file": {"type": "string"},
          "description_file": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "source_type": {"type": "string"}
        }
      }
    }
  }
}

