{
  "name": "ThermalController",
  "description": "电池热管理控制器：带迟滞的 PI 控制 + 抗积分饱和，输出泵命令 pump_cmd（0..1）。",
  "inputs": [
    {"name": "enable", "type": "Boolean", "description": "使能"},
    {"name": "temp_ref_C", "type": "Real", "unit": "C", "description": "目标电芯温度（°C）"},
    {"name": "temp_cell_C", "type": "Real", "unit": "C", "description": "测量电芯温度（°C）"},
    {"name": "coolant_temp_C", "type": "Real", "unit": "C", "description": "测量冷却液温度（°C）（可用于前馈/保护）"}
  ],
  "outputs": [
    {"name": "pump_cmd", "type": "Real", "unit": "0..1", "description": "泵命令（0..1）"},
    {"name": "sat_flag", "type": "Boolean", "description": "饱和指示（抗积分饱和触发）"}
  ],
  "parameters": [
    {"name": "kp", "type": "Real", "default": 0.08, "unit": "1/C", "description": "比例增益"},
    {"name": "ki", "type": "Real", "default": 0.010, "unit": "1/(C*s)", "description": "积分增益"},
    {"name": "u_min", "type": "Real", "default": 0.0, "unit": "-", "description": "泵命令最小值"},
    {"name": "u_max", "type": "Real", "default": 1.0, "unit": "-", "description": "泵命令最大值"},

    {"name": "hys_band_C", "type": "Real", "default": 0.8, "unit": "C", "description": "迟滞带（°C），用于避免频繁开关/抖动"},
    {"name": "coolant_overtemp_C", "type": "Real", "default": 60.0, "unit": "C", "description": "冷却液过温保护阈值（超过则强制高泵速）"},

    {"name": "u_slew_per_s", "type": "Real", "default": 0.8, "unit": "1/s", "description": "输出命令最大变化率"}
  ],
  "states": [
    {"name": "integrator", "derivative": "d_integrator_dt"},
    {"name": "u_cmd_state", "derivative": "d_u_cmd_state_dt"}
  ]
}
