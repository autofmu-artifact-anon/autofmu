{
  "name": "BatteryPackPlant",
  "description": "电池包电-热耦合模型（SOC + 电芯温度），包含非线性 OCV(SOC)、Rint(T,SOC) 与热生成。",
  "inputs": [
    {
      "name": "i_load_A",
      "type": "Real",
      "unit": "A",
      "description": "放电电流（A），放电为正；充电为负。"
    },
    {
      "name": "coolant_in_temp_C",
      "type": "Real",
      "unit": "C",
      "description": "进入冷板/电池包的冷却液温度（°C）。"
    }
  ],
  "outputs": [
    {
      "name": "v_term_V",
      "type": "Real",
      "unit": "V",
      "description": "电池包端电压（V）。"
    },
    {
      "name": "soc",
      "type": "Real",
      "unit": "0..1",
      "description": "荷电状态（0..1）。"
    },
    {
      "name": "temp_cell_C",
      "type": "Real",
      "unit": "C",
      "description": "代表性电芯温度（°C）。"
    },
    {
      "name": "heat_gen_W",
      "type": "Real",
      "unit": "W",
      "description": "电池包发热功率（W），包含欧姆热与极化损耗。"
    }
  ],
  "parameters": [
    {"name": "n_series", "type": "Integer", "default": 96, "description": "串联电芯数"},
    {"name": "capacity_Ah", "type": "Real", "default": 50.0, "unit": "Ah", "description": "电芯标称容量"},
    {"name": "coulombic_eff", "type": "Real", "default": 0.995, "unit": "-", "description": "库仑效率（用于充电时可选）"},

    {"name": "soc_min", "type": "Real", "default": 0.05, "unit": "-", "description": "SOC 软下限"},
    {"name": "soc_max", "type": "Real", "default": 0.98, "unit": "-", "description": "SOC 软上限"},

    {"name": "ocv_a0_V", "type": "Real", "default": 3.20, "unit": "V", "description": "OCV(SOC) 多项式常数项"},
    {"name": "ocv_a1_V", "type": "Real", "default": 0.90, "unit": "V", "description": "OCV(SOC) 一次项系数"},
    {"name": "ocv_a2_V", "type": "Real", "default": -0.60, "unit": "V", "description": "OCV(SOC) 二次项系数"},
    {"name": "ocv_a3_V", "type": "Real", "default": 0.35, "unit": "V", "description": "OCV(SOC) 三次项系数"},

    {"name": "r0_Ohm", "type": "Real", "default": 0.0020, "unit": "Ohm", "description": "内阻基值"},
    {"name": "r_soc_gain", "type": "Real", "default": 1.2, "unit": "-", "description": "低 SOC 内阻增益"},
    {"name": "r_temp_beta", "type": "Real", "default": 0.035, "unit": "1/C", "description": "温度对内阻的指数系数（Arrhenius 近似）"},

    {"name": "k_pol_V", "type": "Real", "default": 0.010, "unit": "V", "description": "极化损耗等效电压系数（与 |I| 成正比）"},

    {"name": "thermal_mass_JK", "type": "Real", "default": 65000.0, "unit": "J/K", "description": "电池包等效热容"},
    {"name": "h_cool_WK", "type": "Real", "default": 120.0, "unit": "W/K", "description": "电池到冷却液的等效对流换热系数"},
    {"name": "temp_min_C", "type": "Real", "default": -10.0, "unit": "C", "description": "数值保护下限温度"},
    {"name": "temp_max_C", "type": "Real", "default": 80.0, "unit": "C", "description": "数值保护上限温度"}
  ],
  "states": [
    {"name": "soc", "derivative": "d_soc_dt"},
    {"name": "temp_cell_C", "derivative": "d_temp_cell_dt"}
  ]
}
