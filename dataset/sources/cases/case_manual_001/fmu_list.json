        {"name": "pump_cmd", "unit": "0..1", "description": "Pump command"},
        {"name": "fan_cmd", "unit": "0..1", "description": "Fan command"},
        {"name": "mode", "unit": "enum", "description": "Supervisory mode (0=NORMAL, 1=DERATE, 2=SHUTDOWN)"}
