        {"name": "cart_friction_Nspm", "default": 0.1, "unit": "N*s/m"},
        {"name": "pend_damping_Nms", "default": 0.02, "unit": "N*m*s"}
      ],
      "states": [
        {"name": "x_m_state", "description": "小车位置"},
        {"name": "x_dot_mps_state", "description": "小车速度"},
        {"name": "theta_rad_state", "description": "摆角"},
        {"name": "theta_dot_radps_state", "description": "摆角速度"}
      ]
