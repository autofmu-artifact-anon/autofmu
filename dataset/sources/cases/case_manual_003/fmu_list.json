      "parameters": [
        {"name": "Kp_theta", "default": 80.0, "unit": "N/rad"},
        {"name": "Kd_theta", "default": 12.0, "unit": "N/(rad/s)"},
        {"name": "Ki_theta", "default": 10.0, "unit": "N/(rad·s)"},
        {"name": "Kp_x", "default": 2.0, "unit": "N/m"},
        {"name": "Kd_x", "default": 2.5, "unit": "N/(m/s)"},
        {"name": "Ki_x", "default": 0.5, "unit": "N/(m·s)"},
        {"name": "u_max_N", "default": 15.0, "unit": "N"},
        {"name": "deadzone_N", "default": 0.3, "unit": "N"},
        {"name": "actuator_tau_s", "default": 0.05, "unit": "s"},
        {"name": "antiwindup_gain", "default": 5.0, "unit": "1/s"}
      ],
      "states": [
        {"name": "int_theta", "description": "摆角误差积分"},
        {"name": "int_x", "description": "位置误差积分"},
        {"name": "force_act_N", "description": "执行器输出力"}
      ]
    },
    {
      "name": "InvertedPendulumPlant",
      "fmu_path": "fmus/InvertedPendulumPlant.fmu",
      "guid": "{b2c3d4e5-f6a7-8901-bcde-f23456789012}",
      "description": "非线性倒立摆小车动力学模型：4状态（位置、速度、角度、角速度），含摩擦和阻尼",
      "type": "Co-Simulation",
      "fmi_version": "2.0",
      "inputs": [
        {"name": "force_cmd_N", "type": "Real", "unit": "N", "description": "水平控制力指令"},
        {"name": "disturbance_N", "type": "Real", "unit": "N", "description": "外部水平扰动力"}
