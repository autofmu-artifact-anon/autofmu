      "outputs": [
        {"name": "x_m", "type": "Real", "unit": "m", "description": "小车位置"},
        {"name": "x_dot_mps", "type": "Real", "unit": "m/s", "description": "小车速度"},
        {"name": "theta_rad", "type": "Real", "unit": "rad", "description": "摆角（0=竖直向上）"},
        {"name": "theta_dot_radps", "type": "Real", "unit": "rad/s", "description": "摆角速度"}
