  part def Rabbitmq {
    out target_x_ur5e : Integer;
    out target_y_ur5e : Integer;
    out target_z_ur5e : Integer;
    out target_x_kuka : Integer;
    out target_y_kuka : Integer;
    out target_z_kuka : Integer;
    out command_move_ur5e : Boolean;
    out command_move_kuka : Boolean;
    out motion_time_ur5e : Real;
    out motion_time_kuka : Real;
  }
  part def SystemFlexCell {
    part kuka : Unifmu;
    part rabbitmq : Rabbitmq;
    part ur5e : Unifmu;
    connect rabbitmq.target_z_kuka to kuka.target_z;
    connect rabbitmq.target_x_ur5e to ur5e.target_x;
    connect rabbitmq.target_y_ur5e to ur5e.target_y;
    connect rabbitmq.target_y_kuka to kuka.target_y;
    connect rabbitmq.target_z_ur5e to ur5e.target_z;
    connect rabbitmq.target_x_kuka to kuka.target_x;
    connect rabbitmq.motion_time_ur5e to ur5e.motion_time;
    connect rabbitmq.motion_time_kuka to kuka.motion_time;
  }
}
