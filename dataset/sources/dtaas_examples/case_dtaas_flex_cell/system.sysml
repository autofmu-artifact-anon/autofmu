    out actual_y_1 : Real;
    out actual_z_1 : Real;
    out actual_rx_1 : Real;
    out actual_ry_1 : Real;
    out actual_rz_1 : Real;
    out actual_x_2 : Integer;
    out actual_y_2 : Integer;
