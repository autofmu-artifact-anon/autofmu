<?xml version="1.0" ?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" version="1.0" name="Feedthrough">
  <ssd:System name="Feedthrough">
    <ssd:Elements>
