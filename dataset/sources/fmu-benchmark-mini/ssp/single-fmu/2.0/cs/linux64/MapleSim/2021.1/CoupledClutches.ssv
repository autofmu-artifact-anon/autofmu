<?xml version="1.0" ?>
<ssv:ParameterSet xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues" version="1.0" name="CoupledClutches_parameters">
  <ssv:Parameters>
    <ssv:Parameter name="T2">
      <ssc:Real value="0.4" unit="s"/>
    </ssv:Parameter>
    <ssv:Parameter name="freqHz">
      <ssc:Real value="0.2" unit="Hz"/>
    </ssv:Parameter>
    <ssv:Parameter name="minsamplestep">
      <ssc:Real value="0.025" unit="s"/>
    </ssv:Parameter>
    <ssv:Parameter name="binfilename">
      <ssc:String value="DISABLED"/>
    </ssv:Parameter>
  </ssv:Parameters>
</ssv:ParameterSet>
