{
  "asset_id": "asset_case_case_manual_005__ThermalController",
  "backend_kind": "python_source_fmu",
  "capabilities": {
    "can_be_instantiated_only_once_per_process": false,
    "can_handle_variable_communication_step_size": true,
    "can_interpolate_inputs": false,
    "can_run_asynchronously": false,
    "needs_execution_tool": false,
    "provides_directional_derivatives": false
  },
  "default_experiment": {
    "startTime": 0.0,
    "stepSize": 0.01,
    "stopTime": 1.0
  },
  "description": "电池热管理控制器：带迟滞的 PI 控制 + 抗积分饱和，输出泵命令 pump_cmd（0..1）。",
  "fmi_types": [
    "Co-Simulation"
  ],
  "fmi_version": "2.0",
  "inputs": [
    "enable",
    "temp_ref_C",
    "temp_cell_C",
    "coolant_temp_C"
  ],
  "name": "ThermalController",
  "outputs": [
    "pump_cmd",
    "sat_flag"
  ],
  "ports": [
    {
      "causality": "input",
      "description": "使能",
      "name": "enable",
      "type": "Boolean",
      "unit": "",
      "variability": "continuous"
    },
    {
      "causality": "input",
      "description": "目标电芯温度（°C）",
      "name": "temp_ref_C",
      "type": "Real",
      "unit": "C",
      "variability": "continuous"
    },
    {
      "causality": "input",
      "description": "测量电芯温度（°C）",
      "name": "temp_cell_C",
      "type": "Real",
      "unit": "C",
      "variability": "continuous"
    },
    {
      "causality": "input",
      "description": "测量冷却液温度（°C）（可用于前馈/保护）",
      "name": "coolant_temp_C",
      "type": "Real",
      "unit": "C",
      "variability": "continuous"
    },
    {
      "causality": "output",
      "description": "泵命令（0..1）",
      "name": "pump_cmd",
      "type": "Real",
      "unit": "0..1",
      "variability": "continuous"
    },
    {
      "causality": "output",
      "description": "饱和指示（抗积分饱和触发）",
      "name": "sat_flag",
      "type": "Boolean",
      "unit": "",
      "variability": "continuous"
    },
    {
      "causality": "parameter",
      "description": "比例增益",
      "name": "kp",
      "type": "Real",
      "unit": "1/C",
      "variability": "fixed"
    },
    {
      "causality": "parameter",
      "description": "积分增益",
      "name": "ki",
      "type": "Real",
      "unit": "1/(C*s)",
      "variability": "fixed"
    },
    {
      "causality": "parameter",
      "description": "泵命令最小值",
      "name": "u_min",
      "type": "Real",
      "unit": "-",
      "variability": "fixed"
    },
    {
      "causality": "parameter",
      "description": "泵命令最大值",
      "name": "u_max",
      "type": "Real",
      "unit": "-",
      "variability": "fixed"
    },
    {
      "causality": "parameter",
      "description": "迟滞带（°C），用于避免频繁开关/抖动",
      "name": "hys_band_C",
      "type": "Real",
      "unit": "C",
      "variability": "fixed"
    },
    {
      "causality": "parameter",
      "description": "冷却液过温保护阈值（超过则强制高泵速）",
      "name": "coolant_overtemp_C",
      "type": "Real",
      "unit": "C",
      "variability": "fixed"
    },
    {
      "causality": "parameter",
      "description": "输出命令最大变化率",
      "name": "u_slew_per_s",
      "type": "Real",
      "unit": "1/s",
      "variability": "fixed"
    }
  ],
  "schema": "UNIFIED_FMU_METADATA_V1"
}
