      "type": "Real",
      "unit": "degC",
      "variability": "fixed"
    },
    {
      "causality": "parameter",
      "description": "Upper bound for coolant temperature to avoid numerical issues.",
      "name": "T_max_C",
      "type": "Real",
      "unit": "degC",
