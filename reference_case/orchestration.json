        "asset_ship_propulsion__fuel_consumption_model",
        "asset_ship_propulsion__hull_load_estimator",
        "asset_ship_propulsion__cavitation_proxy",
        "asset_ship_propulsion__exhaust_thermal_monitor"
      ],
      "schedule": {
        "kind": "co_simulation",
        "start_time": 0,
        "stop_time": 300,
        "step_size": 0.005
      }
    }
  ]
}
